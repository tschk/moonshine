{
  "name": "@tschk/moonshine-waku",
  "version": "0.2.0",
  "description": "Waku adapter — moonshine + waku/router + shaders",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts",
    "./shaders": "./src/shaders.ts"
  },
  "dependencies": {
    "@tschk/moonshine": "workspace:*",
    "@tschk/moonshine-shaders": "file:../shaders"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "waku": ">=0.21"
  },
  "peerDependenciesMeta": {
    "waku": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "moonshine",
    "waku",
    "adapter"
  ],
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "exit 0",
    "test": "exit 0"
  }
}
