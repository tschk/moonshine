{
  "name": "@tschk/moonshine",
  "version": "0.2.0",
  "description": "Hyperminimal signal runtime — Bun-first; import /react for TSX apps",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./host-react": "./src/host-react.ts",
    "./runes": "./src/runes.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./router": "./src/router.ts",
    "./server": "./src/server.ts",
    "./shaders": "./src/shaders.ts"
  },
  "dependencies": {
    "@tschk/moonshine-shaders": "file:../shaders"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "7.0.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "signals",
    "moonshine",
    "bun",
    "react",
    "runes"
  ]
}
