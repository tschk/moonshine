{
  "name": "@tschk/moonshine-astro",
  "version": "0.2.0",
  "description": "Astro adapter — moonshine islands + shaders + optional router",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./shaders": "./src/shaders.ts"
  },
  "dependencies": {
    "@tschk/moonshine": "workspace:*",
    "@tschk/moonshine-shaders": "file:../shaders"
  },
  "peerDependencies": {
    "astro": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "moonshine",
    "astro",
    "adapter"
  ],
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "exit 0",
    "test": "exit 0"
  }
}
