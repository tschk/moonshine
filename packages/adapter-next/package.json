{
  "name": "@tschk/moonshine-next",
  "version": "0.3.3",
  "description": "Next.js API surface reimplemented on moonshine — drop Next, keep the imports",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./navigation": "./src/navigation.ts",
    "./link": "./src/link.ts",
    "./image": "./src/image.ts",
    "./script": "./src/script.ts",
    "./headers": "./src/headers.ts",
    "./dynamic": "./src/dynamic.ts",
    "./font/google": "./src/font/google.ts",
    "./aliases": "./src/aliases.ts",
    "./shaders": "./src/shaders.ts"
  },
  "dependencies": {
    "@tschk/moonshine": "^0.3.3",
    "@tschk/moonshine-router": "^0.3.3",
    "@tschk/moonshine-shaders": "^0.3.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "moonshine",
    "next",
    "adapter"
  ],
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  }
}
