{
  "name": "@tschk/moonshine-angular",
  "version": "0.4.1",
  "description": "Angular hosting adapter — peer @angular/* re-exports plus moonshine signal bridges",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./common": "./src/common.ts"
  },
  "dependencies": {
    "@tschk/crepus-moonshine": "^0.4.1",
    "@tschk/moonshine": "^0.4.1",
    "@tschk/moonshine-framework": "^0.4.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/common": ">=17"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "moonshine",
    "angular",
    "adapter"
  ],
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  }
}
