{
  "name": "@tschk/moonshine-nuxt",
  "version": "0.2.0",
  "description": "Nuxt adapter — moonshine + #app composables",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./vue": "./src/vue-reexport.ts"
  },
  "dependencies": {
    "@tschk/moonshine": "workspace:*",
    "@tschk/moonshine-vue": "file:../adapter-vue"
  },
  "peerDependencies": {
    "nuxt": ">=3",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "moonshine",
    "nuxt",
    "adapter"
  ],
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "exit 0",
    "test": "exit 0"
  }
}
