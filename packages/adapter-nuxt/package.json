{
  "name": "@tschk/moonshine-nuxt",
  "version": "0.4.39",
  "description": "Native signal bridges and rendering with optional legacy nuxt entries",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./vue": "./src/vue.ts"
  },
  "dependencies": {
    "@tschk/moonshine": "^0.4.39",
    "@tschk/moonshine-dom": "^0.4.39"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "nuxt": ">=3",
    "vue": ">=3",
    "@tschk/moonshine-framework": "^0.4.39"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@tschk/moonshine-framework": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "moonshine",
    "nuxt",
    "adapter"
  ],
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  }
}
