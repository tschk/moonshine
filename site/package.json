{
  "name": "@tschk/moonshine-site",
  "private": true,
  "version": "0.3.6",
  "description": "moonshine.tsc.hk — the moonshine showcase, built on moonshine and served from Cloudflare Workers",
  "type": "module",
  "scripts": {
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun run build:routes && bun run build:client && bun run build:worker",
    "build:routes": "bun ../packages/cli/bin/moonshine.ts build --adapter cloudflare",
    "build:client": "bun build src/client.tsx --outfile .moonshine/public/client.js --target browser --production --minify",
    "build:worker": "bun build src/worker.ts --outfile .moonshine/worker.js --target browser --format esm --production --minify",
    "preview": "bun run build && bunx wrangler dev",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "dependencies": {
    "@tschk/moonshine": "^0.3.6",
    "@tschk/moonshine-deploy-cloudflare": "^0.3.6",
    "@tschk/moonshine-framework": "^0.3.6",
    "@tschk/moonshine-react": "^0.3.6",
    "@tschk/moonshine-router": "^0.3.6",
    "@tschk/moonshine-server": "^0.3.6"
  },
  "devDependencies": {
    "@tschk/moonshine-cli": "^0.3.6",
    "@types/bun": "1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "7.0.2",
    "wrangler": "^4.45.0"
  }
}
