{
  "name": "@tschk/moonshine-example-native-template",
  "version": "0.4.62",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "moonshine build",
    "dev": "moonshine dev",
    "start": "bun .moonshine/server.ts",
    "compile:dom": "moonshine compile templates/counter.tsx",
    "compile:ssr": "moonshine compile templates/counter.tsx --ssr",
    "compile:runes:dom": "moonshine compile templates/runes/counter.svelte",
    "compile:runes:ssr": "moonshine compile templates/runes/counter.svelte --ssr",
    "format": "bunx prettier --check moonshine.config.ts src test README.md package.json tsconfig.json",
    "lint": "bunx oxlint src test moonshine.config.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@tschk/moonshine-dom": "workspace:*",
    "@tschk/moonshine-svelte": "workspace:*",
    "@tschk/moonshine-framework": "workspace:*",
    "@tschk/moonshine-server": "workspace:*",
    "@tschk/moonshine-deploy-bun": "workspace:*"
  },
  "devDependencies": {
    "@tschk/moonshine-cli": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
