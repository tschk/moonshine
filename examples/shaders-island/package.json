{
  "name": "@tschk/moonshine-example-shaders-island",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build:client": "bun build ./src/client.tsx --outdir=public --target=browser --format=esm --minify",
    "dev": "bun run build:client && bun run --watch src/server.ts",
    "start": "bun run build:client && bun run src/server.ts",
    "test": "bun test",
    "format": "bunx prettier --check .",
    "lint": "bunx oxlint .",
    "typecheck": "exit 0"
  },
  "dependencies": {
    "@tschk/moonshine": "workspace:*",
    "@tschk/moonshine-shaders": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "7.0.2"
  }
}
