{
  "name": "moonshine-monorepo",
  "version": "0.4.79",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tschk/crepuscularity-wasm": "^0.1.3",
    "@tschk/moonshine": "^0.4.79",
    "@tschk/moonshine-cli": "^0.4.79",
    "@tschk/moonshine-compiler": "^0.4.79",
    "@tschk/moonshine-deploy-bun": "^0.4.79",
    "@tschk/moonshine-deploy-cloudflare": "^0.4.79",
    "@tschk/moonshine-framework": "^0.4.79",
    "@tschk/moonshine-react": "^0.4.79",
    "@tschk/moonshine-router": "^0.4.79",
    "@tschk/moonshine-server": "^0.4.79",
    "@tschk/moonshine-shaders": "^0.4.79",
    "@types/bun": "1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "latest",
    "happy-dom": "^20.11.1",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "solid-js": "1.9.14",
    "typescript": "7.0.2"
  },
  "description": "Moonshine — hyperminimal Bun-first UI runtime; signals + Bun server + optional bridges",
  "license": "ISC",
  "private": true,
  "scripts": {
    "format": "bun x prettier --check .",
    "lint": "bun x oxlint .",
    "typecheck": "bun scripts/typecheck.ts",
    "typecheck:native": "bun scripts/typecheck.ts native",
    "test": "bun test packages components site/test examples/bun-server examples/hybrid-app packages/adapter-*/test && bun run check:catalog",
    "check": "bun run typecheck && bun run check:packages && bun run check:catalog && bun run check:adapters",
    "check:packages": "bun scripts/check-packages.ts",
    "check:size": "bun scripts/check-size.ts",
    "check:catalog": "bun scripts/sync-catalog-check.ts",
    "check:adapters": "bun scripts/check-adapters.ts",
    "check:sfc": "bun scripts/check-native-sfc.ts",
    "moonshine": "bun packages/cli/bin/moonshine.ts",
    "check:bindings": "bun scripts/check-native-bindings.ts",
    "check:components": "bun scripts/check-native-components.ts"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "components",
    "examples/*",
    "site"
  ]
}
